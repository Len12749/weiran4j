# Docker Compose 外部生产配置示例：复制为 application-prod.yml。
# 并在 server/.env 中设置 SPRING_PROFILES_ACTIVE=prod 后自动加载。
# 密钥建议引用 .env 注入的环境变量，不要在此重复写明文。

spring:
  datasource:
    # Compose 默认连 compose 内的 mysql 服务。使用外部数据库时可覆盖此地址。
    # url: jdbc:mysql://db.example.com:3306/weiran4j?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
    password: ${WEIRAN_DB_PASSWORD:}

weiran:
  auth:
    jwt:
      secret: ${WEIRAN_JWT_SECRET:}
