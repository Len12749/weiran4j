# weiran4j 部署环境变量（复制为 weiran4j/.env 后填写；.env 已被 gitignore，绝不提交）
#
# 清单与 weiran-app/src/main/resources/application.yml 的 ${WEIRAN_*} 占位符一一对应，
# 由 EnvExampleTest 守住：改配置时漏改本文件，`./gradlew check` 会失败。
# 用法见 docs/02-部署.md：
#   export COMPOSE_ENV_FILES=weiran4j/.env && docker compose up -d --build
# 也可以直接作为 java -jar 的环境变量（export 或 systemd EnvironmentFile）。
# Docker 可选 profile 配置见 config/application-prod.yml.example；使用时复制为 application-prod.yml，取消下面注释。
# SPRING_PROFILES_ACTIVE=prod
#
# 标「必填」的没有可用的默认值；其余留空或删掉即使用默认值（写在每行右侧注释里）。

# ── 数据库 ──
# JDBC 地址。Docker Compose 部署时由 docker-compose.yml 改写为指向 mysql 服务，这里填本机直连时的地址即可。
WEIRAN_DB_URL=jdbc:mysql://127.0.0.1:3306/weiran4j?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
# 数据库账号。Compose 部署时 MySQL 容器用 root，与这里保持一致。默认 root
WEIRAN_DB_USERNAME=root
# 必填：数据库密码。Compose 部署时同时作为 MySQL 容器的 root 密码。
WEIRAN_DB_PASSWORD=

# ── 服务 ──
# 后端监听端口。默认 5200
WEIRAN_PORT=5200
# 对外访问地址（浏览器地址栏里的协议 + 域名 + 端口，不带结尾斜杠）。
# 外部身份登录用它拼回调与登出回跳地址（不从请求头推断，防 Host 头注入）；未接入外部身份时可以不改。默认 http://localhost:5202
WEIRAN_PUBLIC_BASE_URL=http://localhost:5202

# ── 认证（D-014）──
# 必填：JWT HS256 密钥，至少 32 字节，缺失或过短时应用启动失败。生成：openssl rand -base64 48
WEIRAN_JWT_SECRET=
# 令牌有效期（同时是认证 Cookie 的 Max-Age）。默认 12h
WEIRAN_JWT_TTL=12h
# 本地签发令牌的签发方 / 受众（JWT iss / aud）。一般不改。默认 weiran4j
WEIRAN_JWT_ISSUER=weiran4j
WEIRAN_JWT_AUDIENCE=weiran4j
# 认证 Cookie 是否带 Secure。线上 HTTPS 必须为 true；只有在 http://（如本机试运行 Compose）访问时才设 false，
# 否则浏览器不保存 Cookie，表现为「登录成功后立刻掉线」。默认 true
WEIRAN_COOKIE_SECURE=true
# 是否允许用密码登录。设 false 后只有内置超管（admin）还能用密码登录，作为外部身份提供方故障时的应急入口。默认 true
WEIRAN_PASSWORD_LOGIN_ENABLED=true

# ── 文件存储（图片库）──
# disabled 时拒绝上传；local 仅供开发测试；aliyun 使用阿里云 OSS。默认 disabled
WEIRAN_STORAGE_MODE=disabled
# local 模式的本地根目录和访问前缀。默认 uploads 与 /system-uploads
WEIRAN_STORAGE_LOCAL_ROOT=uploads
WEIRAN_STORAGE_LOCAL_URL_PREFIX=/system-uploads
# aliyun 模式必填：Endpoint、Bucket、公网访问前缀与 RAM 子账号凭据
WEIRAN_STORAGE_ALIYUN_ENDPOINT=
WEIRAN_STORAGE_ALIYUN_BUCKET=
WEIRAN_STORAGE_ALIYUN_ACCESS_KEY_ID=
WEIRAN_STORAGE_ALIYUN_ACCESS_KEY_SECRET=
WEIRAN_STORAGE_ALIYUN_PUBLIC_BASE_URL=

# ── 短信发送（disabled 默认；local 模式会记录模板内容；aliyun 凭据在环境变量中配置）──
WEIRAN_SMS_MODE=disabled
WEIRAN_SMS_ALIYUN_ACCESS_KEY_ID=
WEIRAN_SMS_ALIYUN_ACCESS_KEY_SECRET=

# ── 外部身份提供方（D-015，可选，可配多个）──
# 不在 application.yml 里留占位符：提供方数量与 id 由部署决定，直接用环境变量配置，<ID> 为提供方 id 的大写形式。
# 回调地址需要在提供方处登记：<WEIRAN_PUBLIC_BASE_URL>/api-backend/n/system/auth/callbackSso/<id>，详见 docs/02-部署.md「外部身份提供方」。
# OIDC 示例（id = keycloak）：
# WEIRAN_AUTH_PROVIDERS_KEYCLOAK_TYPE=oidc
# WEIRAN_AUTH_PROVIDERS_KEYCLOAK_NAME=统一身份
# WEIRAN_AUTH_PROVIDERS_KEYCLOAK_ISSUER=https://sso.example.com/realms/example
# WEIRAN_AUTH_PROVIDERS_KEYCLOAK_CLIENT_ID=weiran4j
# WEIRAN_AUTH_PROVIDERS_KEYCLOAK_CLIENT_SECRET=
# WEIRAN_AUTH_PROVIDERS_KEYCLOAK_AUTO_PROVISION=false
# WEIRAN_AUTH_PROVIDERS_KEYCLOAK_DEFAULT_ROLES=
# CAS 示例（id = cas）：
# WEIRAN_AUTH_PROVIDERS_CAS_TYPE=cas
# WEIRAN_AUTH_PROVIDERS_CAS_NAME=统一认证
# WEIRAN_AUTH_PROVIDERS_CAS_SERVER_URL=https://cas.example.com/cas

# ── 日志（artifact.md#10）──
# com.weiran 包的日志级别；设 DEBUG 时 SQL 写入 weiran4j-sql.log。默认 INFO
WEIRAN_LOG_LEVEL=INFO
# 日志文件目录（weiran4j.log、weiran4j-sql.log）。Compose 部署时挂卷到 /app/logs。默认 logs（相对工作目录）
WEIRAN_LOG_DIR=logs
# 日志按天滚动后保留的天数。默认 30
WEIRAN_LOG_MAX_HISTORY=30

# ── 停机 ──
# 优雅停机每个阶段最多等多久；容器编排的强杀时限必须比它长（Compose 里 stop_grace_period 为 40s）。默认 30s
WEIRAN_SHUTDOWN_TIMEOUT=30s

# ── 仅 Docker Compose 使用 ──
# 前端 Nginx 对外端口。默认 5202
WEIRAN_WEB_PORT=5202
