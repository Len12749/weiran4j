# 本地开发配置样例。复制为 config/application-local.yml 后填真实值：
#
#   cp config/application-local.yml.example config/application-local.yml
#
# config/application-local.yml 已在 .gitignore 中，且位于源码树之外——它不会进版本库，
# 也不会被打进 jar。`./gradlew :weiran-app:bootRun` 默认激活 local profile 并加载这里。
#
# ⚠️ 密钥只能写在这里（或环境变量），绝不能写进 weiran-app/src/main/resources/application*.yml，
#    那些文件会随 bootJar 一起分发。

spring:
  datasource:
    # 空库即可：启动时 Flyway 自动建表并写入种子数据（admin / admin123，上线前必须改密）。
    #   CREATE DATABASE weiran4j DEFAULT CHARACTER SET utf8mb4;
    url: jdbc:mysql://127.0.0.1:3306/weiran4j?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: root
    password: ""

weiran:
  auth:
    jwt:
      # 至少 32 字节，否则应用启动时直接失败。
      # 生成方式：openssl rand -base64 48
      secret: ""
      ttl: 12h
    cookie:
      # 本地是 http://localhost，Safari 不接受 http 下的 Secure Cookie。
      secure: false

server:
  port: 3310

logging:
  level:
    com.weiran: DEBUG
